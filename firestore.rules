rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function signedInUserRole() {
      return signedInUser().data.role;
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && signedInUserRole() == 'student';
    }

    function userFields() {
      return [
        'uid',
        'firstName',
        'lastName',
        'email',
        'phoneNumber',
        'role',
        'department',
        'faculty',
        'matricNumber',
        'staffId',
        'profilePhotoUrl',
        'isEmailVerified',
        'isActive',
        'institutionId',
        'createdAt',
        'updatedAt'
      ];
    }

    function studentEditableProfileFields() {
      return [
        'firstName',
        'lastName',
        'phoneNumber',
        'faculty',
        'profilePhotoUrl',
        'updatedAt'
      ];
    }

    function isValidStudentProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(userFields())
        && request.resource.data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'email',
          'role',
          'department',
          'matricNumber',
          'isEmailVerified',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isActive == true
        && request.resource.data.isEmailVerified == request.auth.token.email_verified
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.department is string
        && request.resource.data.matricNumber is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    // Lecturers register themselves, but always start inactive — they have
    // no lecturer permissions until a coordinator approves them (see
    // isLecturerUser and isValidLecturerAccessChange). Mirrors the student
    // rule, with a staff ID required instead of a matric number.
    function isValidLecturerProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(userFields())
        && request.resource.data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'email',
          'role',
          'department',
          'staffId',
          'isEmailVerified',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'lecturer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isActive == false
        && request.resource.data.isEmailVerified == request.auth.token.email_verified
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.department is string
        && request.resource.data.staffId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    // A coordinator approving (or deactivating) a lecturer account: only
    // isActive and updatedAt may change, and only on a lecturer's document.
    function isValidLecturerAccessChange() {
      return isCoordinator()
        && resource.data.role == 'lecturer'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isActive', 'updatedAt'])
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(studentEditableProfileFields())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.department == resource.data.department
        && request.resource.data.matricNumber == resource.data.matricNumber
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isEmailVerified == resource.data.isEmailVerified
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string;
    }

    function isValidEmailVerificationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isEmailVerified', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.department == resource.data.department
        && request.resource.data.matricNumber == resource.data.matricNumber
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isEmailVerified == request.auth.token.email_verified
        && request.resource.data.updatedAt is timestamp;
    }

    function internshipFields() {
      return [
        'internshipId',
        'studentId',
        'studentName',
        'studentMatricNumber',
        'lecturerId',
        'lecturerName',
        'coordinatorId',
        'status',
        'companyName',
        'companyAddress',
        'companyLatitude',
        'companyLongitude',
        'companySupervisorName',
        'companySupervisorPhone',
        'department',
        'country',
        'state',
        'startDate',
        'endDate',
        'submittedAt',
        'approvedAt',
        'rejectedAt',
        'assignedAt',
        'activatedAt',
        'completedAt',
        'createdAt',
        'updatedAt'
      ];
    }

    function isValidStudentInternshipCreate(internshipId) {
      return isStudent()
        && request.resource.data.keys().hasOnly(internshipFields())
        && request.resource.data.keys().hasAll([
          'internshipId',
          'studentId',
          'studentName',
          'studentMatricNumber',
          'status',
          'companyName',
          'companyAddress',
          'companyLatitude',
          'companyLongitude',
          'companySupervisorName',
          'companySupervisorPhone',
          'department',
          'country',
          'state',
          'startDate',
          'endDate',
          'submittedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.internshipId == internshipId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.lecturerId == null
        && request.resource.data.lecturerName == null
        && request.resource.data.coordinatorId == null
        && request.resource.data.approvedAt == null
        && request.resource.data.rejectedAt == null
        && request.resource.data.assignedAt == null
        && request.resource.data.activatedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.studentName is string
        && request.resource.data.studentMatricNumber is string
        && request.resource.data.companyName is string
        && request.resource.data.companyAddress is string
        && (
          request.resource.data.companyLatitude is int
          || request.resource.data.companyLatitude is float
        )
        && (
          request.resource.data.companyLongitude is int
          || request.resource.data.companyLongitude is float
        )
        && request.resource.data.companySupervisorName is string
        && request.resource.data.companySupervisorPhone is string
        && request.resource.data.department is string
        && request.resource.data.country is string
        && request.resource.data.state is string
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isCoordinator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && signedInUserRole() == 'coordinator';
    }

    // A lecturer only has lecturer powers once a coordinator has approved
    // the account (isActive == true). Lecturers self-register with
    // isActive false, so without this check anyone could sign up as a
    // "lecturer" and immediately read student records. Every lecturer
    // permission in this file goes through this one function.
    function isLecturerUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && signedInUserRole() == 'lecturer'
        && signedInUser().data.isActive == true;
    }

    function isValidCoordinatorApproval() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'coordinatorId', 'approvedAt', 'updatedAt'])
        && resource.data.status == 'pending_review'
        && request.resource.data.status == 'approved'
        && request.resource.data.coordinatorId == request.auth.uid
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCoordinatorRejection() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'coordinatorId', 'rejectedAt', 'updatedAt'])
        && resource.data.status == 'pending_review'
        && request.resource.data.status == 'rejected'
        && request.resource.data.coordinatorId == request.auth.uid
        && request.resource.data.rejectedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isLecturer(lecturerId) {
      return exists(/databases/$(database)/documents/users/$(lecturerId))
        && get(/databases/$(database)/documents/users/$(lecturerId)).data.role
          == 'lecturer'
        && get(/databases/$(database)/documents/users/$(lecturerId)).data.isActive
          == true;
    }

    function isValidCoordinatorAssignment() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lecturerId', 'lecturerName', 'assignedAt', 'updatedAt'])
        && resource.data.status == 'approved'
        && request.resource.data.status == 'assigned'
        && isLecturer(request.resource.data.lecturerId)
        && request.resource.data.lecturerName is string
        && request.resource.data.assignedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function attendanceFields() {
      return [
        'attendanceId',
        'internshipId',
        'studentId',
        'studentName',
        'studentMatricNumber',
        'lecturerId',
        'lecturerName',
        'companyName',
        'state',
        'date',
        'checkInTime',
        'checkOutTime',
        'checkInLatitude',
        'checkInLongitude',
        'checkInAccuracyMetres',
        'checkInDistanceMetres',
        'checkInLocationMocked',
        'checkOutLatitude',
        'checkOutLongitude',
        'status',
        'createdAt',
        'updatedAt'
      ];
    }

    function isInternshipActiveForStudent(internshipId, studentId) {
      return exists(/databases/$(database)/documents/internships/$(internshipId))
        && get(/databases/$(database)/documents/internships/$(internshipId)).data.studentId
          == studentId
        && get(/databases/$(database)/documents/internships/$(internshipId)).data.status
          == 'active';
    }

    function isValidAttendanceCreate() {
      return isStudent()
        && request.resource.data.keys().hasOnly(attendanceFields())
        && request.resource.data.keys().hasAll([
          'attendanceId',
          'internshipId',
          'studentId',
          'studentName',
          'studentMatricNumber',
          'lecturerId',
          'lecturerName',
          'companyName',
          'state',
          'date',
          'checkInTime',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && isInternshipActiveForStudent(
          request.resource.data.internshipId,
          request.auth.uid
        )
        && request.resource.data.status == 'checked_in'
        && request.resource.data.checkOutTime == null
        && request.resource.data.date is timestamp
        && request.resource.data.checkInTime is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && isValidAttendanceLocation();
    }

    // The location fields are asserted by the client, so these rules check
    // their shape, not their truth: nothing here can tell a real GPS fix
    // from a spoofed one, and rules cannot recompute the distance (there
    // is no trigonometry in the rules language). What they do enforce is
    // that a distance is never claimed without the coordinates it was
    // measured from, so a record is either internally consistent or
    // visibly unverified. Real verification needs a server-side check or
    // the employer sign-off in the roadmap.
    function isValidAttendanceLocation() {
      let data = request.resource.data;
      return (!('checkInLatitude' in data) || data.checkInLatitude == null
          || (data.checkInLatitude is number
            && data.checkInLatitude >= -90 && data.checkInLatitude <= 90))
        && (!('checkInLongitude' in data) || data.checkInLongitude == null
          || (data.checkInLongitude is number
            && data.checkInLongitude >= -180 && data.checkInLongitude <= 180))
        && (!('checkInAccuracyMetres' in data)
          || data.checkInAccuracyMetres == null
          || (data.checkInAccuracyMetres is number
            && data.checkInAccuracyMetres >= 0))
        && (!('checkInDistanceMetres' in data)
          || data.checkInDistanceMetres == null
          || (data.checkInDistanceMetres is number
            && data.checkInDistanceMetres >= 0
            && data.checkInLatitude != null
            && data.checkInLongitude != null))
        && (!('checkInLocationMocked' in data)
          || data.checkInLocationMocked is bool);
    }

    function isValidAttendanceCheckOut() {
      return isOwner(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['checkOutTime', 'status', 'updatedAt'])
        && resource.data.status == 'checked_in'
        && request.resource.data.status == 'completed'
        && request.resource.data.checkOutTime is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function logbookEntryFields() {
      return [
        'entryId',
        'internshipId',
        'studentId',
        'studentName',
        'studentMatricNumber',
        'lecturerId',
        'lecturerName',
        'companyName',
        'state',
        'date',
        'activities',
        'skillsLearned',
        'challenges',
        'solutionsApplied',
        'hoursWorked',
        'attachmentUrls',
        'status',
        'lecturerComments',
        'createdAt',
        'updatedAt'
      ];
    }

    function hasValidLogbookContent() {
      return request.resource.data.activities is string
        && request.resource.data.skillsLearned is string
        && request.resource.data.challenges is string
        && request.resource.data.solutionsApplied is string
        && (
          request.resource.data.hoursWorked is int
          || request.resource.data.hoursWorked is float
        )
        && request.resource.data.updatedAt is timestamp;
    }

    // The first submission for a day is a create() (no prior document).
    // A resubmission after changes were requested reuses the same
    // deterministic doc ID, so Firestore treats it as an update() even
    // though the client calls set() either way -- hence a separate
    // student-edit rule below with the same content validation.
    function isValidLogbookCreate() {
      return isStudent()
        && request.resource.data.keys().hasOnly(logbookEntryFields())
        && request.resource.data.keys().hasAll([
          'entryId',
          'internshipId',
          'studentId',
          'studentName',
          'studentMatricNumber',
          'lecturerId',
          'lecturerName',
          'companyName',
          'state',
          'date',
          'activities',
          'skillsLearned',
          'challenges',
          'solutionsApplied',
          'hoursWorked',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && isInternshipActiveForStudent(
          request.resource.data.internshipId,
          request.auth.uid
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp
        && hasValidLogbookContent();
    }

    function isValidLogbookStudentEdit() {
      return isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status != 'approved'
        && request.resource.data.keys().hasOnly(logbookEntryFields())
        && request.resource.data.entryId == resource.data.entryId
        && request.resource.data.internshipId == resource.data.internshipId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.lecturerId == resource.data.lecturerId
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'pending'
        && hasValidLogbookContent();
    }

    function isValidLogbookLecturerReview() {
      return isLecturerUser()
        && resource.data.lecturerId == request.auth.uid
        && resource.data.status == 'pending'
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'approved'
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'lecturerComments', 'updatedAt'])
            && request.resource.data.status == 'changes_requested'
            && request.resource.data.lecturerComments is string
          )
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCoordinatorActivation() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'activatedAt', 'updatedAt'])
        && resource.data.status == 'assigned'
        && request.resource.data.status == 'active'
        && request.resource.data.activatedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCoordinatorCompletion() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completedAt', 'updatedAt'])
        && resource.data.status == 'active'
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isLecturerAssignedToInternship(internshipId, lecturerId) {
      return exists(/databases/$(database)/documents/internships/$(internshipId))
        && get(/databases/$(database)/documents/internships/$(internshipId)).data.lecturerId
          == lecturerId;
    }

    function supervisionReportFields() {
      return [
        'reportId',
        'internshipId',
        'lecturerId',
        'lecturerName',
        'studentId',
        'studentName',
        'studentMatricNumber',
        'companyName',
        'state',
        'visitDate',
        'studentPresent',
        'companyRepresentativePresent',
        'observation',
        'recommendations',
        'rating',
        'photoUrls',
        'createdAt'
      ];
    }

    // BR-SUP-001/002/003: only the assigned lecturer may create a report,
    // linked to exactly one internship, and reports are immutable — there
    // is no corresponding update/delete rule below.
    function isValidSupervisionReportCreate(reportId) {
      return isLecturerUser()
        && request.resource.data.keys().hasOnly(supervisionReportFields())
        && request.resource.data.keys().hasAll(supervisionReportFields())
        && request.resource.data.reportId == reportId
        && request.resource.data.lecturerId == request.auth.uid
        && isLecturerAssignedToInternship(
          request.resource.data.internshipId,
          request.auth.uid
        )
        && request.resource.data.lecturerName is string
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.studentMatricNumber is string
        && request.resource.data.companyName is string
        && request.resource.data.state is string
        && request.resource.data.visitDate is timestamp
        && request.resource.data.studentPresent is bool
        && request.resource.data.companyRepresentativePresent is bool
        && request.resource.data.observation is string
        && request.resource.data.recommendations is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.photoUrls is list
        && request.resource.data.createdAt is timestamp;
    }

    function notificationFields() {
      return [
        'notificationId',
        'recipientId',
        'recipientRole',
        'senderId',
        'senderName',
        'title',
        'message',
        'type',
        'relatedEntityId',
        'relatedEntityType',
        'isRead',
        'createdAt'
      ];
    }

    // Notifications are written as part of the action they describe (an
    // approval, a review, a visit report), so any signed-in actor may
    // create one for another user — but never for themselves, and never
    // pre-read. The action's own rule is what gates whether the batch
    // commits at all.
    function isValidNotificationCreate(notificationId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(notificationFields())
        && request.resource.data.keys().hasAll([
          'notificationId',
          'recipientId',
          'recipientRole',
          'title',
          'message',
          'type',
          'isRead',
          'createdAt'
        ])
        && request.resource.data.notificationId == notificationId
        && request.resource.data.recipientId is string
        && request.resource.data.recipientRole is string
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.type is string
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp;
    }

    // The DDS allows exactly one mutation: the recipient marking it read.
    function isValidNotificationRead() {
      return isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead'])
        && request.resource.data.isRead == true;
    }

    function auditEventFields() {
      return [
        'eventId',
        'actorId',
        'actorName',
        'actorRole',
        'action',
        'entityType',
        'entityId',
        'targetUserId',
        'description',
        'metadata',
        'createdAt'
      ];
    }

    // Kept general (any signed-in user, any action) rather than scoped to
    // one feature, since every future write path (Phase 7's audit retrofit)
    // needs this exact same shape — an actor recording their own action.
    function isValidAuditEventCreate(eventId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(auditEventFields())
        && request.resource.data.keys().hasAll([
          'eventId',
          'actorId',
          'actorName',
          'actorRole',
          'action',
          'entityType',
          'entityId',
          'description',
          'createdAt'
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorRole is string
        && request.resource.data.action is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.description is string
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{userId} {
      // Lecturers need student profiles for FR-SUP-002 (student name,
      // matric number, and contact details on the student detail screen).
      // This is deliberately "any student", not "only my assigned
      // students": rules can't express the assignment check here, since
      // that lives on an internships document this rule has no queryable
      // path to (rules support get()/exists() by known ID, not queries).
      allow get: if isOwner(userId)
        || isCoordinator()
        || (isLecturerUser() && resource.data.role == 'student');
      allow list: if isCoordinator();
      allow create: if isValidStudentProfileCreate(userId)
        || isValidLecturerProfileCreate(userId);
      allow update: if (isOwner(userId)
        && (
          isValidProfileUpdate()
          || isValidEmailVerificationUpdate()
        ))
        || isValidLecturerAccessChange();
      // A user may delete their own profile when they delete their account
      // (App Store / Google Play account deletion requirement). Nobody else
      // can delete a profile; placement records elsewhere are unaffected.
      allow delete: if isOwner(userId);
    }

  match /internships/{internshipId} {
    allow get, list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidStudentInternshipCreate(internshipId);
    allow update: if isCoordinator()
      && (
        isValidCoordinatorApproval()
        || isValidCoordinatorRejection()
        || isValidCoordinatorAssignment()
        || isValidCoordinatorActivation()
        || isValidCoordinatorCompletion()
      );
    allow delete: if false;
  }

  match /attendance/{attendanceId} {
    // get() and list() are deliberately separate rules, not combined.
    // get() needs the `!exists(...)` branch so a lookup on today's
    // not-yet-created deterministic doc ID resolves to "not found"
    // instead of erroring (resource is null for a missing document, so
    // resource.data.studentId throws, which Firestore treats as a
    // denial). list() never needs that branch (every document a list
    // query returns already exists) — and mixing an exists()/get() call
    // into a list rule's OR chain caused Firestore to silently exclude
    // otherwise-matching documents from results rather than erroring.
    allow get: if (isSignedIn()
        && !exists(/databases/$(database)/documents/attendance/$(attendanceId)))
      || (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidAttendanceCreate();
    allow update: if isValidAttendanceCheckOut();
    allow delete: if false;
  }

  match /logbook_entries/{entryId} {
    // Same get()/list() split as attendance, same reasoning.
    allow get: if (isSignedIn()
        && !exists(/databases/$(database)/documents/logbook_entries/$(entryId)))
      || (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidLogbookCreate();
    allow update: if isValidLogbookStudentEdit() || isValidLogbookLecturerReview();
    allow delete: if false;
  }

  match /supervision_reports/{reportId} {
    // Report IDs are auto-generated (not deterministic/guessable the way
    // attendance/logbook daily IDs are), so there's no "lookup a
    // not-yet-created doc" case here — no !exists() branch needed.
    allow get, list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidSupervisionReportCreate(reportId);
    allow update, delete: if false;
  }

  match /notifications/{notificationId} {
    // Users see only their own notifications (DDS business rule).
    allow get, list: if isSignedIn()
      && resource.data.recipientId == request.auth.uid;
    allow create: if isValidNotificationCreate(notificationId);
    allow update: if isValidNotificationRead();
    allow delete: if false;
  }

  match /audit_events/{eventId} {
    // Per the DDS: only coordinators see all events; a lecturer sees only
    // events they themselves performed (their own submitted reports,
    // etc.); students have no access to this collection at all.
    allow get, list: if isCoordinator()
      || (isLecturerUser() && resource.data.actorId == request.auth.uid);
    allow create: if isValidAuditEventCreate(eventId);
    allow update, delete: if false;
  }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

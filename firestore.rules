rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function signedInUserRole() {
      return signedInUser().data.role;
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && signedInUserRole() == 'student';
    }

    function userFields() {
      return [
        'uid',
        'firstName',
        'lastName',
        'email',
        'phoneNumber',
        'role',
        'department',
        'faculty',
        'matricNumber',
        'staffId',
        'profilePhotoUrl',
        'isEmailVerified',
        'isActive',
        'institutionId',
        'createdAt',
        'updatedAt'
      ];
    }

    function studentEditableProfileFields() {
      return [
        'firstName',
        'lastName',
        'phoneNumber',
        'faculty',
        'profilePhotoUrl',
        'updatedAt'
      ];
    }

    function isValidStudentProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(userFields())
        && request.resource.data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'email',
          'role',
          'department',
          'matricNumber',
          'isEmailVerified',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isActive == true
        && request.resource.data.isEmailVerified == request.auth.token.email_verified
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.department is string
        && request.resource.data.matricNumber is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(studentEditableProfileFields())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.department == resource.data.department
        && request.resource.data.matricNumber == resource.data.matricNumber
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isEmailVerified == resource.data.isEmailVerified
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string;
    }

    function isValidEmailVerificationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isEmailVerified', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.department == resource.data.department
        && request.resource.data.matricNumber == resource.data.matricNumber
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isEmailVerified == request.auth.token.email_verified
        && request.resource.data.updatedAt is timestamp;
    }

    function internshipFields() {
      return [
        'internshipId',
        'studentId',
        'lecturerId',
        'lecturerName',
        'coordinatorId',
        'status',
        'companyName',
        'companyAddress',
        'companyLatitude',
        'companyLongitude',
        'companySupervisorName',
        'companySupervisorPhone',
        'department',
        'state',
        'startDate',
        'endDate',
        'submittedAt',
        'approvedAt',
        'rejectedAt',
        'assignedAt',
        'activatedAt',
        'completedAt',
        'createdAt',
        'updatedAt'
      ];
    }

    function isValidStudentInternshipCreate(internshipId) {
      return isStudent()
        && request.resource.data.keys().hasOnly(internshipFields())
        && request.resource.data.keys().hasAll([
          'internshipId',
          'studentId',
          'status',
          'companyName',
          'companyAddress',
          'companyLatitude',
          'companyLongitude',
          'companySupervisorName',
          'companySupervisorPhone',
          'department',
          'state',
          'startDate',
          'endDate',
          'submittedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.internshipId == internshipId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.lecturerId == null
        && request.resource.data.lecturerName == null
        && request.resource.data.coordinatorId == null
        && request.resource.data.approvedAt == null
        && request.resource.data.rejectedAt == null
        && request.resource.data.assignedAt == null
        && request.resource.data.activatedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.companyName is string
        && request.resource.data.companyAddress is string
        && (
          request.resource.data.companyLatitude is int
          || request.resource.data.companyLatitude is float
        )
        && (
          request.resource.data.companyLongitude is int
          || request.resource.data.companyLongitude is float
        )
        && request.resource.data.companySupervisorName is string
        && request.resource.data.companySupervisorPhone is string
        && request.resource.data.department is string
        && request.resource.data.state is string
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isCoordinator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && signedInUserRole() == 'coordinator';
    }

    function isLecturerUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && signedInUserRole() == 'lecturer';
    }

    function isValidCoordinatorApproval() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'coordinatorId', 'approvedAt', 'updatedAt'])
        && resource.data.status == 'pending_review'
        && request.resource.data.status == 'approved'
        && request.resource.data.coordinatorId == request.auth.uid
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCoordinatorRejection() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'coordinatorId', 'rejectedAt', 'updatedAt'])
        && resource.data.status == 'pending_review'
        && request.resource.data.status == 'rejected'
        && request.resource.data.coordinatorId == request.auth.uid
        && request.resource.data.rejectedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isLecturer(lecturerId) {
      return exists(/databases/$(database)/documents/users/$(lecturerId))
        && get(/databases/$(database)/documents/users/$(lecturerId)).data.role
          == 'lecturer';
    }

    function isValidCoordinatorAssignment() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lecturerId', 'lecturerName', 'assignedAt', 'updatedAt'])
        && resource.data.status == 'approved'
        && request.resource.data.status == 'assigned'
        && isLecturer(request.resource.data.lecturerId)
        && request.resource.data.lecturerName is string
        && request.resource.data.assignedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function attendanceFields() {
      return [
        'attendanceId',
        'internshipId',
        'studentId',
        'studentName',
        'studentMatricNumber',
        'lecturerId',
        'lecturerName',
        'companyName',
        'state',
        'date',
        'checkInTime',
        'checkOutTime',
        'checkInLatitude',
        'checkInLongitude',
        'checkOutLatitude',
        'checkOutLongitude',
        'status',
        'createdAt',
        'updatedAt'
      ];
    }

    function isInternshipActiveForStudent(internshipId, studentId) {
      return exists(/databases/$(database)/documents/internships/$(internshipId))
        && get(/databases/$(database)/documents/internships/$(internshipId)).data.studentId
          == studentId
        && get(/databases/$(database)/documents/internships/$(internshipId)).data.status
          == 'active';
    }

    function isValidAttendanceCreate() {
      return isStudent()
        && request.resource.data.keys().hasOnly(attendanceFields())
        && request.resource.data.keys().hasAll([
          'attendanceId',
          'internshipId',
          'studentId',
          'studentName',
          'studentMatricNumber',
          'lecturerId',
          'lecturerName',
          'companyName',
          'state',
          'date',
          'checkInTime',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && isInternshipActiveForStudent(
          request.resource.data.internshipId,
          request.auth.uid
        )
        && request.resource.data.status == 'checked_in'
        && request.resource.data.checkOutTime == null
        && request.resource.data.date is timestamp
        && request.resource.data.checkInTime is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidAttendanceCheckOut() {
      return isOwner(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['checkOutTime', 'status', 'updatedAt'])
        && resource.data.status == 'checked_in'
        && request.resource.data.status == 'completed'
        && request.resource.data.checkOutTime is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function logbookEntryFields() {
      return [
        'entryId',
        'internshipId',
        'studentId',
        'studentName',
        'studentMatricNumber',
        'lecturerId',
        'lecturerName',
        'companyName',
        'state',
        'date',
        'activities',
        'skillsLearned',
        'challenges',
        'solutionsApplied',
        'hoursWorked',
        'attachmentUrls',
        'status',
        'lecturerComments',
        'createdAt',
        'updatedAt'
      ];
    }

    function hasValidLogbookContent() {
      return request.resource.data.activities is string
        && request.resource.data.skillsLearned is string
        && request.resource.data.challenges is string
        && request.resource.data.solutionsApplied is string
        && (
          request.resource.data.hoursWorked is int
          || request.resource.data.hoursWorked is float
        )
        && request.resource.data.updatedAt is timestamp;
    }

    // The first submission for a day is a create() (no prior document).
    // A resubmission after changes were requested reuses the same
    // deterministic doc ID, so Firestore treats it as an update() even
    // though the client calls set() either way -- hence a separate
    // student-edit rule below with the same content validation.
    function isValidLogbookCreate() {
      return isStudent()
        && request.resource.data.keys().hasOnly(logbookEntryFields())
        && request.resource.data.keys().hasAll([
          'entryId',
          'internshipId',
          'studentId',
          'studentName',
          'studentMatricNumber',
          'lecturerId',
          'lecturerName',
          'companyName',
          'state',
          'date',
          'activities',
          'skillsLearned',
          'challenges',
          'solutionsApplied',
          'hoursWorked',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && isInternshipActiveForStudent(
          request.resource.data.internshipId,
          request.auth.uid
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp
        && hasValidLogbookContent();
    }

    function isValidLogbookStudentEdit() {
      return isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status != 'approved'
        && request.resource.data.keys().hasOnly(logbookEntryFields())
        && request.resource.data.entryId == resource.data.entryId
        && request.resource.data.internshipId == resource.data.internshipId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.lecturerId == resource.data.lecturerId
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'pending'
        && hasValidLogbookContent();
    }

    function isValidLogbookLecturerReview() {
      return isLecturerUser()
        && resource.data.lecturerId == request.auth.uid
        && resource.data.status == 'pending'
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'approved'
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'lecturerComments', 'updatedAt'])
            && request.resource.data.status == 'changes_requested'
            && request.resource.data.lecturerComments is string
          )
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCoordinatorActivation() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'activatedAt', 'updatedAt'])
        && resource.data.status == 'assigned'
        && request.resource.data.status == 'active'
        && request.resource.data.activatedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isCoordinator();
      allow list: if isCoordinator();
      allow create: if isValidStudentProfileCreate(userId);
      allow update: if isOwner(userId)
        && (
          isValidProfileUpdate()
          || isValidEmailVerificationUpdate()
        );
      allow delete: if false;
    }

  match /internships/{internshipId} {
    allow get, list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidStudentInternshipCreate(internshipId);
    allow update: if isCoordinator()
      && (
        isValidCoordinatorApproval()
        || isValidCoordinatorRejection()
        || isValidCoordinatorAssignment()
        || isValidCoordinatorActivation()
      );
    allow delete: if false;
  }

  match /attendance/{attendanceId} {
    // get() and list() are deliberately separate rules, not combined.
    // get() needs the `!exists(...)` branch so a lookup on today's
    // not-yet-created deterministic doc ID resolves to "not found"
    // instead of erroring (resource is null for a missing document, so
    // resource.data.studentId throws, which Firestore treats as a
    // denial). list() never needs that branch (every document a list
    // query returns already exists) — and mixing an exists()/get() call
    // into a list rule's OR chain caused Firestore to silently exclude
    // otherwise-matching documents from results rather than erroring.
    allow get: if (isSignedIn()
        && !exists(/databases/$(database)/documents/attendance/$(attendanceId)))
      || (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidAttendanceCreate();
    allow update: if isValidAttendanceCheckOut();
    allow delete: if false;
  }

  match /logbook_entries/{entryId} {
    // Same get()/list() split as attendance, same reasoning.
    allow get: if (isSignedIn()
        && !exists(/databases/$(database)/documents/logbook_entries/$(entryId)))
      || (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow list: if (isStudent() && resource.data.studentId == request.auth.uid)
      || (isLecturerUser() && resource.data.lecturerId == request.auth.uid)
      || isCoordinator();
    allow create: if isValidLogbookCreate();
    allow update: if isValidLogbookStudentEdit() || isValidLogbookLecturerReview();
    allow delete: if false;
  }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

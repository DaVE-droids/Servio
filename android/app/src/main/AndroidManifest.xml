<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Firebase, address search, and maps links all need the network.
         Flutter only adds this permission to debug builds, so release builds
         must declare it here. See docs/PERMISSIONS.md. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Attendance check-in records how far the phone is from the company
         address, so a lecturer can see which claimed workdays are backed by
         a location. COARSE is declared alongside FINE because Android 12+
         lets the user grant only approximate location, and an approximate
         fix is still useful here (the geofence is 250 m). Neither is
         background location: Servio only asks while the student is on the
         attendance screen tapping check in. See docs/PERMISSIONS.md. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Servio offers its own updates, because builds handed out directly
         don't come from the Play Store and so nothing else tells people a
         new version exists. This permission only lets Servio ask Android to
         install a package; Android still shows its own install screen and
         the user still taps Install. Gated at runtime by
         AppConstants.selfUpdateEnabled, which must be false for any build
         uploaded to Play. See docs/APP_UPDATES.md. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- No CAMERA or storage permissions: taking a profile photo hands off to
         the system camera app, and choosing one uses Android's photo picker,
         neither of which needs a permission. -->

    <application
        android:label="Servio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Lets Servio hand a downloaded update to the system installer:
             since Android 7 another app cannot be given a raw file path, so
             the file is shared as a content URI instead. Not exported, and
             scoped to the app's own cache directory by servio_file_paths.
             See docs/APP_UPDATES.md. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/servio_file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Apps Servio hands off to (Android 11+ package visibility):
         text processing (Flutter engine), web links and maps (the privacy
         policy, directions to a company), and the camera app (profile
         photo). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>

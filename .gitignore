app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local admin tooling — never commit service account keys or seeded credentials
scripts/*-account.json
scripts/node_modules/
scripts/seed-output.json
scripts/servio-account.json
# Firebase CLI debug output
firepit-log.txt
firebase-debug.log
firestore-debug.log

# Build-time secrets. env.local.json holds the LocationIQ token; it is read
# by `flutter build ... --dart-define-from-file=env.local.json` and must
# never be committed. Copy env.example.json to create it.
env.local.json
.env
.env.local

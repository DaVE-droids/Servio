rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfilePhoto() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_photos/{userId}/avatar.jpg {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidProfilePhoto();
      // Deleting sends no new file, so it can't pass the upload checks
      // above; owners may always remove their own photo (used when they
      // remove it or delete their account).
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
